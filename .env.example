# Referencia de variables para IntelliJ, terminal o entorno de despliegue.
# Este archivo .env NO se carga automáticamente. Para arranque simple usar conexion-db.properties.
DB_URL=jdbc:postgresql://127.0.0.1:5432/sgcivorp_local
DB_USERNAME=postgres
DB_PASSWORD=
ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
# JWT_SECRET: Base64 de al menos 32 bytes aleatorios, generado y guardado fuera de Git.
# Sin JWT_SECRET, reiniciar la API invalida las sesiones web anteriores.
TIENDA_DEMO=true
TIENDA_TITULAR=Jorge Reyes
TIENDA_YAPE=DEMO - no transferir
TIENDA_DIRECCION=Asociación de Vivienda La Planicie de la Era / Zona de La Era de Pando, Ate, Lima 15487. Referencia: Pista nueva-Santa Clara, al costado de Ceviche69.
TIENDA_HORARIO=Lunes a sabado, de 8:00 a. m. a 8:00 p. m.
TIENDA_MAPA_URL=https://maps.app.goo.gl/fYfcULhRuRgEEYhZ7
