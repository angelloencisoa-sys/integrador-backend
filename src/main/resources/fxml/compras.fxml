<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pe.edu.utp.Grupo06.view.ComprasViewController"
      spacing="16" alignment="TOP_LEFT" maxWidth="Infinity" maxHeight="Infinity">

    <!-- Encabezado -->
    <HBox alignment="CENTER_LEFT" spacing="15">
        <VBox spacing="2">
            <Label text="Compras y Abastecimiento de Mercadería" styleClass="main-title"/>
            <Label text="Registro de facturas/boletas de compra a proveedores (Aumenta stock automáticamente)" styleClass="sub-title"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="🔄 Refrescar" onAction="#cargarCompras"
                styleClass="btn, btn-default" style="-fx-cursor: hand;"/>
        <Button text="➕ Registrar Nueva Compra" onAction="#handleNuevaCompra"
                styleClass="btn, btn-primary" style="-fx-font-weight: bold; -fx-cursor: hand;"/>
    </HBox>

    <!-- Barra de Filtros y Búsqueda -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <TextField fx:id="txtFiltroCompra" promptText="Buscar por N° Comprobante o Proveedor..." prefWidth="280" styleClass="text-field"/>
        <Label text="Desde:" style="-fx-text-fill: #475569; -fx-font-weight: bold; -fx-font-size: 12px;"/>
        <DatePicker fx:id="dpFechaInicio" prefWidth="135"/>
        <Label text="Hasta:" style="-fx-text-fill: #475569; -fx-font-weight: bold; -fx-font-size: 12px;"/>
        <DatePicker fx:id="dpFechaFin" prefWidth="135"/>
        <Button text="🔍 Filtrar" onAction="#handleFiltrarCompras" style="-fx-background-color: #0284c7; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 6;"/>
        <Button text="Limpiar" onAction="#handleLimpiarFiltroCompras" style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 6;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblTotalCompras" text="Total Compras: S/ 0.00" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #0284c7;"/>
    </HBox>

    <!-- Tabla de Compras Realizadas -->
    <TableView fx:id="tblCompras" VBox.vgrow="ALWAYS" styleClass="table-view">
        <columns>
            <TableColumn fx:id="colComprobante" text="N° Comprobante" prefWidth="150"/>
            <TableColumn fx:id="colProveedor" text="Proveedor" prefWidth="250"/>
            <TableColumn fx:id="colFecha" text="Fecha de Compra" prefWidth="160"/>
            <TableColumn fx:id="colUsuario" text="Registrado Por" prefWidth="160"/>
            <TableColumn fx:id="colTotal" text="Total Compra (S/)" prefWidth="130"/>
            <TableColumn fx:id="colEstadoCompra" text="Estado" prefWidth="110"/>
            <TableColumn fx:id="colAcciones" text="Acción" prefWidth="120"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

</VBox>
